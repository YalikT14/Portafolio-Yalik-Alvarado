header.header
  nav.navbar.container
    a.navbar-logo(href='/' aria-label='Ir al inicio')
      img.logo-icon(src='/images/isotipo color.png' width='60' alt='')
      img.logo-text(src='/images/Yalik_Monocromatico 2.png' height='70' alt='Yalik Tapuy')
    
    //- Menú desktop
    ul.navbar-menu
      li
        a.nav-link(href='/portafolio') Portafolio
      li
        a.nav-link(href='/sobre-mi') Sobre Mí
      li
        a.nav-link.contact-link(href='mailto:yalik.alvarado@outlook.com')
          span yalik.alvarado@outlook.com
    
    //- Toggle móvil
    button#toggle.button_container(
      type='button'
      aria-label='Abrir menú'
      aria-expanded='false'
      aria-controls='overlay'
    )
      span.top
      span.middle
      span.bottom
    
//- Overlay menú móvil
#overlay.overlay(aria-hidden='true')
  nav.overlay-menu
    ul
      li: a(href='/') Inicio
      li: a(href='/portafolio') Portafolio
      li: a(href='/sobre-mi') Sobre Mí
      li: a(href='mailto:globox204@outlook.es') Contacto